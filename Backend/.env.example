PORT=5000

# Local MongoDB
# MONGODB_URI=mongodb://127.0.0.1:27017/rugos_erp

# MongoDB Atlas (Render) — include /restoration OR set MONGODB_DB
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/restoration?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/rugos_erp
MONGODB_DB=restoration

# Auth (P1) — change JWT_SECRET in production
JWT_SECRET=rugos-dev-secret-change-me
JWT_EXPIRES=7d
DEMO_PASSWORD=RugOS@2026
# AUTH_DISABLED=true

# P5 security
# CORS_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173
# AUTH_RATE_LIMIT=40
# API_RATE_LIMIT=300
# SECRETS_KEY=long-random-string-for-integration-encryption

# Razorpay TEST mode — Dashboard → Account & Settings → API Keys → Test Mode
# Key Id is public (rzp_test_…). Key Secret stays on the server only.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

